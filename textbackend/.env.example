# Blogify backend environment
#
# Development SQLite:
DATABASE_URL="file:./dev.db"
#
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/blogify?schema=public"

PORT=4000

# The frontend should use the same port through VITE_API_URL.
# Example: VITE_API_URL=http://localhost:4000

# JWT secrets - replace with long random values in every real environment.
JWT_ACCESS_SECRET=replace-with-secure-random-access-secret
JWT_REFRESH_SECRET=replace-with-secure-random-refresh-secret
JWT_ACCESS_EXP=15m
JWT_REFRESH_EXP=7d
JWT_REFRESH_TTL_MS=604800000

# Password reset tokens are stored hashed and expire after this TTL.
PASSWORD_RESET_TTL_MS=3600000

# Seed admin
SEED_ADMIN_EMAIL=admin@blogify.local
SEED_ADMIN_PASSWORD=change_me

# CORS allowed origins, comma-separated.
CORS_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173

# Runtime limits
MAX_UPLOAD_SIZE=5242880
RATE_LIMIT_MAX=1000

# Set to a positive integer only when deployed behind that many trusted proxies.
TRUST_PROXY=0
